# Game images and extracted game data - never commit
*.bin
*.cue
*.iso
*.img
*.chd
/Tokimeki Memorial*/
/extracted/
# Note: brackets are glob character classes in gitignore, so the patcher's
# "... [English]" output folder must be written with escaped brackets.
*\[English\]/

# Isolated emulator copy, screenshots, RAM dumps (tools/emu)
/.emu/

__pycache__/
*.pyc
