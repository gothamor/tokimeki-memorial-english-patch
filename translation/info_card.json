  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x125F4",
   "original": "趣味は音楽鑑賞、特にクラシック",
   "text": "Loves music, esp. classical"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x12614",
   "original": "成績優秀、スポーツ万能",
   "text": "Top grades, sporty"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x12634",
   "original": "クラシックと恋愛物の映画が好み",
   "text": "Likes classical, love movies"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x12654",
   "original": "ヘアバンドを集めてるらしい",
   "text": "Collects hairbands"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x12674",
   "original": "アクセサリーを集めてるらしい",
   "text": "Collects accessories"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x12694",
   "original": "公園に行くのが好きなようだ",
   "text": "Seems to like parks"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x126B4",
   "original": "身体が弱いことを、気にしている",
   "text": "Worries about her frailty"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x126D4",
   "original": "ゲーテの詩集がお気に入り",
   "text": "Loves Goethe's poems"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x126F4",
   "original": "激しいスポーツはしない",
   "text": "No rough sports"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x12714",
   "original": "落ち着ける音楽が好み",
   "text": "Likes calm music"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x12734",
   "original": "激しいスポーツはしない",
   "text": "No rough sports"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x12754",
   "original": "趣味は読書で、文学作品を好む",
   "text": "Reads, loves literature"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x12774",
   "original": "怪しげな研究をしてるらしい",
   "text": "Does shady research"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x12794",
   "original": "その他、詳しいことは不明",
   "text": "Nothing else known"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x127B4",
   "original": "頭はきれるが、運動は駄目",
   "text": "Sharp, but bad at sports"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x127D4",
   "original": "破壊的なものが好きらしい",
   "text": "Likes destructive stuff"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x127F4",
   "original": "きらめき高校の※※※科学者",
   "text": "Kirameki's ??? scientist"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x12814",
   "original": "頭脳のためにクラシックを聴く",
   "text": "Hears classical for brains"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x12834",
   "original": "趣味は絵を描くこと",
   "text": "Likes to paint"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x12854",
   "original": "明るく友達が多い、運動は駄目",
   "text": "Cheery, many friends, unsporty"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x12874",
   "original": "グロテスクな絵、ポップスが好み",
   "text": "Likes weird art and pop music"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x12894",
   "original": "静かなところは苦手",
   "text": "Hates quiet"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x128B4",
   "original": "水泳の授業の日は休みがち",
   "text": "Skips swimming classes"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x128D4",
   "original": "グロテスクな絵、ポップスが好み",
   "text": "Likes weird art and pop music"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x128F4",
   "original": "運動部のアイドルで、趣味は料理",
   "text": "Sports clubs' idol; cooks"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x12914",
   "original": "運動はやるより、見るタイプ",
   "text": "Likes watching sports"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x12934",
   "original": "アクション映画、ロックが好み",
   "text": "Likes action films, rock"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x12954",
   "original": "趣味は料理、誰にでも優しい",
   "text": "Cooks, kind to all"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x12974",
   "original": "何事にも頑張る人が好きらしい",
   "text": "Likes people who try hard"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x12994",
   "original": "誰からも慕われている",
   "text": "Loved by everyone"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x129B4",
   "original": "ボーッとしてて、のんき",
   "text": "Dreamy and carefree"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x129D4",
   "original": "趣味は編み物",
   "text": "Knitting"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x129F4",
   "original": "テニス以外のスポーツは苦手",
   "text": "Bad at sports but tennis"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x12A14",
   "original": "うるさいものは嫌いらしい",
   "text": "Dislikes noisy things"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x12A34",
   "original": "ボーッとできるものが好き",
   "text": "Likes to zone out"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x12A54",
   "original": "うるさいものは嫌いらしい",
   "text": "Dislikes noisy things"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x12A74",
   "original": "スポーツ万能、水泳は国体レベル",
   "text": "Sporty; national-level swimmer"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x12A94",
   "original": "優柔不断な男は嫌い",
   "text": "Hates wishy-washy"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x12AB4",
   "original": "身体を動かすことが大好き",
   "text": "Loves to keep moving"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x12AD4",
   "original": "ロックをよく聴く、軟弱者は嫌い",
   "text": "Into rock, hates wimps"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x12AF4",
   "original": "男っぽいことを気にしてる",
   "text": "Self-conscious: boyish"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x12B14",
   "original": "恋愛物の映画が好み",
   "text": "Likes love movies"
  },
  {
   "file": "CDROM/FUKUTEST/JOHO.NBN",
   "offset": "0x12B34",
   "original": "美人で俺好み",
   "text": "Cute, my type"
  },
  {
